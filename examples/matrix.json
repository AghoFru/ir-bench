{
  "datasets": [
    {
      "name": "tiny",
      "source": "examples/tiny"
    },
    {
      "name": "cranfield",
      "source": "irds:cranfield"
    }
  ],
  "engines": [
    {
      "name": "bm25",
      "adapter": "terrier",
      "config": {
        "wmodel": "BM25"
      }
    },
    {
      "name": "e5",
      "adapter": "dense",
      "config": {
        "model": "intfloat/e5-small-v2",
        "query_prompt": "query: ",
        "document_prompt": "passage: ",
        "normalize": true
      }
    },
    {
      "name": "bge",
      "adapter": "dense",
      "config": {
        "model": "BAAI/bge-small-en-v1.5",
        "query_prompt": "Represent this sentence for searching relevant passages: ",
        "document_prompt": "",
        "normalize": true
      }
    },
    {
      "name": "splade",
      "adapter": "splade",
      "config": {
        "model": "naver/splade-cocondenser-ensembledistil"
      }
    }
  ],
  "depth": 100,
  "measures": [
    "nDCG@10",
    "RR@10",
    "AP@100",
    "R@100",
    "Judged@10"
  ],
  "warmup": 1,
  "repeats": 3,
  "seed": 0
}
